# ==============================================================================
# ENDEMIAS GOV - Variáveis de ambiente
# Copie para .env (não versionado) e preencha.
# ==============================================================================

# --- Supabase (OBRIGATÓRIO) ---------------------------------------------------
# Dashboard -> Settings -> API
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_ANON_KEY"

# --- Provisionamento (apenas scripts/, NUNCA no bundle do frontend) ----------
# Dashboard -> Settings -> API -> service_role. Uso pontual, máquina segura.
# SUPABASE_SERVICE_ROLE_KEY="SEU_SERVICE_ROLE_KEY"

# --- Portal do Cidadão (rotas públicas /publico) ---------------------------
# UUID do município exibido no portal quando o link não traz ?municipio=<uuid>.
# Deixe vazio em implantações com vários municípios (use o link com ?municipio=).
VITE_PUBLIC_MUNICIPALITY_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
